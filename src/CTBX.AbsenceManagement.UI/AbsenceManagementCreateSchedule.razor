@page "/vacation-schedule"
@inherits ScheduleFileBase

<PageTitle>Vacation Request</PageTitle>

<MudTabs Elevation="0" Rounded="false" Outlined="true" Centered="true" PanelClass="p-0" Position="Position.Top">
    <MudTabPanel Text="List View">
        <ChildContent>
            <MudDataGrid Items="@_events" Filterable="false" SortMode="@SortMode.None" Groupable="false">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Your Drafts</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="LoadVacationData" />
                    <MudMenu>
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Tertiary">Create Request</MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="OpenDrawer" >Vacation Request</MudMenuItem>
                            <MudMenuItem OnClick="OpenSickLeaveDrawer">Sick Leave Request</MudMenuItem>
                        </ChildContent>
                    </MudMenu>                                 
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.Text" Title="Comment" />
                    <PropertyColumn Property="x => x.Start" Title="From" Format="dd-MM-yyyy" />
                    <PropertyColumn Property="x => x.End" Title="To" Format="dd-MM-yyyy" />
                    <TemplateColumn CellClass="d-flex justify-end">
                        <CellTemplate>
                            <MudStack Row>
                                <MudMenu Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" Dense="true">
                                    <MudMenuItem>
                                        <MudIcon Icon="@Icons.Material.Filled.Delete"/>
                                        Delete
                                    </MudMenuItem>
                                    <MudMenuItem>
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                                        Edit Draft
                                    </MudMenuItem>
                                    <MudMenuItem>
                                        <MudIcon Icon="@Icons.Material.Filled.Send" />
                                        Send
                                    </MudMenuItem>
                                </MudMenu>
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>

		</ChildContent>
    </MudTabPanel>


    <MudTabPanel Text="Calendar View">
        <ChildContent>
            <MudCalendar Color="Color.Inherit" Items="_events" >
                <ToolbarContent>
                    <MudMenu>
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Tertiary">Create Request</MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="OpenDrawer">Vacation Request</MudMenuItem>
                            <MudMenuItem OnClick="OpenSickLeaveDrawer">Sick Leave Request</MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                </ToolbarContent>
        </MudCalendar>
        </ChildContent>
    </MudTabPanel>

    <MudDrawer @bind-Open="_open" Width="600px" Height="100%" Anchor="Anchor.Right" Variant="@DrawerVariant.Temporary">
        <MudCard Class="drawer-card">
            <MudCardContent Class="drawer-card-content">
                <MudText Align="Align.Center">Vacation Request</MudText>
                <MudForm Spacing="2" Class="form-container">
                    <MudDatePicker Label="From" @bind-Date="CurrentRequest.From" />
                    <MudDatePicker Label="To" @bind-Date="CurrentRequest.To" />
                    <MudTextField T="string" Label="Comment" @bind-Text="CurrentRequest.Comment" Lines="3" />
                    <MudButton OnClick="SaveDraft" Variant="Variant.Filled" Color="Color.Success" FullWidth="true">Save Vacation Request</MudButton>
                </MudForm>
            </MudCardContent>
        </MudCard>
    </MudDrawer>

    <MudDrawer @bind-Open="_sickLeaveDrawerOpen" Width="600px" Height="100%" Anchor="Anchor.Right" Variant="@DrawerVariant.Temporary">
        <MudCard Class="drawer-card">
            <MudCardContent Class="drawer-card-content">
                <MudText Align="Align.Center">Sick Leave Request</MudText>
                <MudForm Spacing="2" Class="form-container">
                    <MudDatePicker Label="From" @bind-Date="CurrentRequest.From" />
                    <MudDatePicker Label="To" @bind-Date="CurrentRequest.To" />
                    <MudTextField T="string" Label="Comment" @bind-Text="CurrentRequest.Comment" Lines="3" />
                    <MudButton OnClick="SaveSickLeaveDraft" Variant="Variant.Filled" Color="Color.Success" FullWidth="true">Save Sick Leave Request</MudButton>
                </MudForm>
            </MudCardContent>
        </MudCard>
    </MudDrawer>

</MudTabs>


<MudOverlay @bind-Visible="_visible" DarkBackground>
    <MudProgressCircular Color="Color.Success" Indeterminate="true" />
</MudOverlay>

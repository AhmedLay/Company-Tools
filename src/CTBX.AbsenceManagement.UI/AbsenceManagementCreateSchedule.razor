@page "/vacation-schedule"
@inherits ScheduleFileBase

<PageTitle>Vacation Request</PageTitle>
<MudTabs Elevation="4" Color="@Color.Success" PrevIcon="@Icons.Material.Filled.SkipPrevious" NextIcon="@Icons.Material.Filled.SkipNext">
    <MudTabPanel Text="List View">
        <ChildContent>
            <MudDataGrid Items="@_events" Filterable="false" SortMode="@SortMode.None" Groupable="false">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Your Drafts</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" OnClick="LoadVacationData" />
                    <MudMenu>
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add">
                                Create Request
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="OpenDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.HolidayVillage" Color="Color.Info" /> Vacation Request
                            </MudMenuItem>
                            <MudMenuItem OnClick="OpenSickLeaveDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Color="Color.Error" /> Sick Leave Request
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.Start" Title="From" Format="dd-MM-yyyy" />
                    <PropertyColumn Property="x => x.End" Title="To" Format="dd-MM-yyyy" />
                    <PropertyColumn Property="x => x.Status" Title="Status"/>
                    <PropertyColumn Property="x => x.Text" Title="Note" />
                    <TemplateColumn CellClass="d-flex justify-end">
                        <CellTemplate>
                            @if (context.Item.Status == "Drafted")
                            {
                                <MudStack Row>
                                    <MudMenu Color="Color.Warning">
                                        <ActivatorContent>
                                            <MudButton Color="Color.Info" Variant="Variant.Outlined">
                                                <MudIcon Icon="@Icons.Material.Filled.Settings" class="me-2" />
                                                Action
                                            </MudButton>
                                        </ActivatorContent>
                                        <ChildContent>
                                            <MudMenuItem OnClick="@(() => EditDraft(context.Item))">
                                                <MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Info" class="me-2" />
                                                Edit
                                            </MudMenuItem>
                                            <MudMenuItem OnClick="@(() => ConfirmRequest(context.Item))">
                                                <MudIcon Icon="@Icons.Material.Filled.Send" Color="Color.Success" class="me-2" />
                                                Submit
                                            </MudMenuItem>
                                        </ChildContent>
                                    </MudMenu>
                                </MudStack>
                            }
                            else if (context.Item.Status == "Requested" || context.Item.Status == "Approved")
                            {
                                <MudStack Row>
                                    <MudMenu Color="Color.Warning">
                                        <ActivatorContent>
                                            <MudButton Color="Color.Info" Variant="Variant.Outlined">
                                                <MudIcon Icon="@Icons.Material.Filled.Settings" class="me-2" />
                                                Action
                                            </MudButton>
                                        </ActivatorContent>
                                        <ChildContent>
                                            <MudMenuItem OnClick="@(() => AbondonRequest(context.Item))">
                                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" class="me-2" />
                                                Abondon
                                            </MudMenuItem>                                           
                                        </ChildContent>
                                    </MudMenu>
                                </MudStack>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>

		</ChildContent>
    </MudTabPanel>
    <MudTabPanel Text="Calendar View">
        <ChildContent>
            <MudCalendar Color="Color.Inherit" Items="_events" >
                <ToolbarContent>
                    <MudMenu>
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add">
                                Create Request
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="OpenDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.HolidayVillage" Color="Color.Info" /> Vacation Request
                            </MudMenuItem>
                            <MudMenuItem OnClick="OpenSickLeaveDrawer">
                                <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Color="Color.Error" /> Sick Leave Request
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                </ToolbarContent>
        </MudCalendar>
        </ChildContent>
    </MudTabPanel>
    <MudDrawer @bind-Open="_open" Width="600px" Height="100%" Anchor="Anchor.Right" Variant="@DrawerVariant.Temporary">
        <MudCard Class="drawer-card">
            <MudCardContent Class="drawer-card-content">
                <MudText Align="Align.Center">Request</MudText>
                <MudForm Spacing="2" Class="form-container">
                    <MudDatePicker Label="From" @bind-Date="CurrentRequest.From" />
                    <MudDatePicker Label="To"  @bind-Date="CurrentRequest.To" />
                    <MudTextField T="string" Label="Comment" @bind-Text="CurrentRequest.Comment" Lines="3" />

                    @if (_isEditMode)
                    {
                        <MudButton OnClick="UpdateDraft" Variant="Variant.Filled" Color="Color.Warning" FullWidth="true">
                            Update Request
                        </MudButton>
                    }
                    else
                    {
                        @if (_isVacationRequest)
                        {
                            <MudButton OnClick="SaveDraft" Variant="Variant.Filled" Color="Color.Success" FullWidth="true">
                                Save Vacation Request
                            </MudButton>
                        }
                        else
                        {
                            <MudButton OnClick="SaveSickLeaveDraft" Variant="Variant.Filled" Color="Color.Success" FullWidth="true">
                                Save Sick Leave Request
                            </MudButton>
                        }
                    }
                </MudForm>
            </MudCardContent>
        </MudCard>
    </MudDrawer>
</MudTabs>
<MudOverlay @bind-Visible="_visible" DarkBackground>
    <MudProgressCircular Color="Color.Success" Indeterminate="true" />
</MudOverlay>
